PORT=3000
APP_BASE_URL=http://localhost:3000

# Public launch safety: keep this value until all commercial, regulatory,
# privacy, support, and production gates are complete.
PUBLIC_LAUNCH_MODE=waitlist
# Local/default override. Vercel production uses the dedicated Supabase waitlist
# unless this variable is explicitly set to false there.
WAITLIST_ENABLED=false

# PostgreSQL for the commercial application backend. The public waitlist uses
# its dedicated Supabase backend instead of this database.
DATABASE_URL=postgres://streetwise:streetwise_dev@localhost:5432/streetwise
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_DAYS=30

# Payments: mock or stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Keep false unless you intentionally use an sk_live_ Stripe key.
STRIPE_LIVE_MODE_ENABLED=false

# Runtime eSIM provider values currently supported by the order service: mock, esim-go
ESIM_PROVIDER=mock

# eSIM Go defaults to https://api.esim-go.com/v2.5 when left blank.
ESIM_API_BASE_URL=
ESIM_API_KEY=

# Enables the HMAC-verified eSIM Go V3 callback endpoint.
# This is independent from live ordering so it can be tested safely.
ESIM_WEBHOOKS_ENABLED=false

# Safety switch. Keep false while integrating/testing.
# When false, eSIM Go order requests are validation-only and do not execute a transaction.
ESIM_LIVE_ORDERS_ENABLED=false

# 1GLOBAL Connect backup-provider evaluation. The current client is read-only and
# is not wired into live provisioning. Use credentials only in secret storage.
ONEGLOBAL_API_BASE_URL=https://api.1global.com/connect
ONEGLOBAL_TOKEN_URL=
ONEGLOBAL_CLIENT_ID=
ONEGLOBAL_CLIENT_SECRET=
ONEGLOBAL_API_VERSION=2026-02-05
