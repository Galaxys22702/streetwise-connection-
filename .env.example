PORT=3000
APP_BASE_URL=http://localhost:3000

# Boolean feature/safety values below must be exactly true or false.
# Public launch safety: keep waitlist until all commercial, regulatory,
# privacy, support, and production gates are complete.
PUBLIC_LAUNCH_MODE=waitlist
# Local/default override. Vercel production uses the dedicated Supabase waitlist
# unless this variable is explicitly set to false there.
WAITLIST_ENABLED=false

# PostgreSQL for the commercial application backend. The public waitlist uses
# its dedicated Supabase backend instead of this database.
DATABASE_URL=postgres://streetwise:streetwise_dev@localhost:5432/streetwise
# Set true only when the database endpoint presents a certificate trusted by
# the runtime. TLS certificate verification remains enabled when this is true.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_DAYS=30
MIGRATION_MAX_ATTEMPTS=10

# Payments: mock or stripe. Checkout derives its test price from the selected
# Streetwise plan; live Stripe checkout additionally requires a plan explicitly
# marked sellable in application configuration.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false unless you intentionally use an sk_live_ Stripe key and every launch gate passes.
STRIPE_LIVE_MODE_ENABLED=false

# Runtime order providers currently supported: mock, esim-go.
# AT&T is the primary domestic commercial candidate, but is intentionally NOT wired
# into live ordering until AT&T supplies an approved API/product contract.
ESIM_PROVIDER=mock

# eSIM Go defaults to https://api.esim-go.com/v2.5 when left blank.
ESIM_API_BASE_URL=
ESIM_API_KEY=

# Enables the HMAC-verified eSIM Go callback endpoint.
# This is independent from live ordering so it can be tested safely.
ESIM_WEBHOOKS_ENABLED=false

# Safety switch. Keep false while integrating/testing.
# When false, eSIM Go order requests are validation-only and do not execute a transaction.
ESIM_LIVE_ORDERS_ENABLED=false

# 1GLOBAL Connect backup-provider evaluation. The current client is read-only and
# is not wired into live provisioning. Use credentials only in secret storage.
ONEGLOBAL_API_BASE_URL=https://api.1global.com/connect
ONEGLOBAL_TOKEN_URL=
ONEGLOBAL_CLIENT_ID=
ONEGLOBAL_CLIENT_SECRET=
ONEGLOBAL_API_VERSION=2026-02-05

# AT&T primary domestic provider evaluation.
# These values are placeholders for contract-defined credentials only.
# Do not invent endpoint URLs or place production secrets in Git.
ATT_PARTNER_PATH=
ATT_WHOLESALE_API_BASE_URL=
ATT_WHOLESALE_CLIENT_ID=
ATT_WHOLESALE_CLIENT_SECRET=
ATT_WHOLESALE_ACCOUNT_ID=
ATT_COMMERCIAL_CONTRACT_APPROVED=false
ATT_LIVE_PROVISIONING_ENABLED=false
