{
  "name": "streetwise-connection",
  "version": "0.4.0",
  "private": true,
  "description": "Control plane and waitlist foundation for affordable, security-focused cellular/MVNO service.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm run test:coverage && node scripts/vercel-config-check.js && node scripts/launch-readiness-check.js",
    "check:production": "node scripts/production-smoke-check.js",
    "analyse:provider": "node scripts/analyse-provider-catalogue.js",
    "check:provider-commercial": "node scripts/check-provider-commercial-readiness.js"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "stripe": "^18.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
