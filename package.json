{
  "name": "streetwise-connection",
  "version": "0.4.0",
  "private": true,
  "description": "Control plane and waitlist foundation for affordable, security-focused cellular/MVNO service.",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node --watch src/server.js",
    "lint": "node scripts/check-source.js",
    "build": "node scripts/build-site.js",
    "jarvis:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local jarvis/local/server.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm run lint && npm run test:coverage && node scripts/vercel-config-check.js && node scripts/launch-readiness-check.js && node scripts/repository-integrity-check.js && npm run build",
    "check:production": "node scripts/production-smoke-check.js",
    "analyse:provider": "node scripts/analyse-provider-catalogue.js",
    "check:provider-commercial": "node scripts/check-provider-commercial-readiness.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "stripe": "^23.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
